# Aplicacion
BASE_URL=/talentia/public
DB_HOST=127.0.0.1
DB_NAME=talentia
DB_USER=root
DB_PASS=
CRON_TOKEN=
UMBRAL=80
UMBRAL_CONFIANZA_DOC=0.75

# Proveedores de IA
LLM_PROVIDERS=gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# Correo (log evita enviar correos reales en desarrollo)
MAIL_DRIVER=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=

# Docker Compose requiere un valor fuerte y no vacio.
DB_ROOT_PASS=
